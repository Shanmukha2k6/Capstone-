# DevMind AI - Frontend Environment
VITE_API_URL=http://localhost:8000/api

# Leave blank for local guest mode. Fill all four values for Firebase cloud mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional local Auth/Firestore; requires Java 21+. Never enable in production.
VITE_USE_FIREBASE_EMULATORS=false
